{
  "name": "dentalflow-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "docs:inventory": "bun scripts/audit-source-inventory.cjs ../dentalflow-api --write",
    "docs:check": "bun scripts/check-doc-links.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "bun scripts/coverage-gaps.cjs",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:biome": "biome check .",
    "check:write": "biome check --write .",
    "check:unused": "node scripts/check-unused-files.cjs",
    "check": "bun run check:biome && bun run check:unused",
    "knip": "knip",
    "knip:production": "knip --production"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-router": "^1.168.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.7"
  },
  "packageManager": "bun@1.3.9",
  "overrides": {
    "seroval": "1.5.3"
  }
}
